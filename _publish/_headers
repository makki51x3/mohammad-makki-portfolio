/*
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# HTML: always revalidate so content updates land immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Beacon: short cache, it changes with the site
/analytics.js
  Cache-Control: public, max-age=3600

# Crawler + agent files: cache a day, they change rarely
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# GenAI films + posters: slugs are stable and never replaced in place
# (a new clip gets a new slug), so these CAN be immutable — unlike /assets/*.
/assets/genai/*
  Cache-Control: public, max-age=31536000, immutable

# Static media. NOT immutable: filenames are reused when an asset is replaced
# (e.g. shots/nafas.jpg), so a long immutable cache would strand old images.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Documents (CV, papers): filenames are stable and get REPLACED in place,
# so never let a browser serve a stale copy of the CV.
/assets/docs/*
  Cache-Control: public, max-age=0, must-revalidate
